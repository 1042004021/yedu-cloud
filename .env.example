PORT=8787

# 存储驱动：s3=R2/S3 兼容（推荐），qiniu=七牛
STORAGE_DRIVER=s3

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=yedu
R2_REGION=auto
# 不填则由 R2_ACCOUNT_ID 自动拼成 https://<account>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false

# 至少 32 个字符，建议 openssl rand -hex 32
SERVER_SECRET=replace-with-at-least-32-characters
KEY_PREFIX=yedu

DB_PATH=./data/yedu.db

UPLOAD_TOKEN_TTL_SECONDS=3600
DOWNLOAD_TTL_SECONDS=3600
DEVICE_TOKEN_TTL_SECONDS=2592000
MAX_UPLOAD_BYTES=33554432
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=1

# 可选：继续使用七牛时启用
# STORAGE_DRIVER=qiniu
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=https://cdn.example.com
# QINIU_UPLOAD_HOST=https://upload.qiniup.com
# QINIU_PRIVATE=true