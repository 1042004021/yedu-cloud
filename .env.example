PORT=8787

# 七牛密钥：只放在服务端，绝不提交到仓库，也不要打进 APK
QINIU_ACCESS_KEY=replace-with-access-key
QINIU_SECRET_KEY=replace-with-secret-key
QINIU_BUCKET=replace-with-bucket
# 正式环境必须使用已绑定到 Bucket 的自定义域名；七牛测试域名仅用于联调
QINIU_DOMAIN=https://cdn.example.com
QINIU_UPLOAD_HOST=https://upload.qiniup.com

# true=私有空间（推荐）；false=公开空间
QINIU_PRIVATE=true

# 至少 32 个字符，建议 openssl rand -hex 32
SERVER_SECRET=replace-with-at-least-32-characters
KEY_PREFIX=yedu

UPLOAD_TOKEN_TTL_SECONDS=3600
DOWNLOAD_TTL_SECONDS=3600
DEVICE_TOKEN_TTL_SECONDS=2592000
MAX_UPLOAD_BYTES=33554432
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=1
